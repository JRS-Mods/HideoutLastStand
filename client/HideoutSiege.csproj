<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HideoutSiege</AssemblyName>
    <RootNamespace>HideoutSiege</RootNamespace>
